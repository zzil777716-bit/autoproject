# ==============================================================================
# 🔐 ANTIGRAVITY ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# 복사하여 .env 로 이름을 바꾼 후 실제 API Key를 입력하세요.
# 절대 실제 API 키가 포함된 .env 파일을 깃허브에 커밋하지 마세요!
# ==============================================================================

# 1. 키움증권 REST API 자격증명 (한국 주식 매매)
KIWOOM_APP_KEY=your_kiwoom_app_key_here
KIWOOM_SECRET_KEY=your_kiwoom_secret_key_here
KIWOOM_ACCOUNT_NO=8133507611
KIWOOM_IS_SIMULATION=true

# 2. 업비트 REST API 자격증명 (가상자산 매매)
UPBIT_ACCESS_KEY=your_upbit_access_key_here
UPBIT_SECRET_KEY=your_upbit_secret_key_here

# 3. 빗썸 API 자격증명 (선택 사항)
BITHUMB_CONNECT_KEY=your_bithumb_connect_key_here
BITHUMB_SECRET_KEY=your_bithumb_secret_key_here

# 4. 텔레그램 실시간 양방향 봇 연동
# @BotFather 에서 봇 생성 후 발급받은 토큰
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# 본인의 텔레그램 Chat ID (숫자)
TELEGRAM_CHAT_ID=your_telegram_numeric_chat_id_here